# ===== YourFM backend config (standalone, ported off Emergent) =====
# Copy this file to `.env` and fill in your own values.

# --- Database ---
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=yourfm

# --- Gemini (DJ script generation) ---
# Google AI Studio key (starts with "AIza" or "AQ."). Get one: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- ElevenLabs (DJ voices) ---
# Your xi-api-key from https://elevenlabs.io (Profile -> API Keys)
ELEVEN_API_KEY=your_elevenlabs_api_key_here

# --- Feed.fm (licensed music) ---
# Public demo credentials play Feed.fm's demo station. Replace when you get API access.
FEED_FM_TOKEN=demo
FEED_FM_SECRET=demo

# --- Optional integrations (features degrade gracefully if left blank) ---
WEATHER_API_KEY=
SEATGEEK_CLIENT_ID=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:8000/api/spotify/callback
FRONTEND_URL=http://localhost:3000

# ===== Sandbox-only flags — DO NOT set these when running locally / on Emergent =====
# These exist only for previewing inside Perplexity's proxied sandbox, where API keys are
# injected by an outbound auth proxy instead of living in this file. On a normal machine you
# have your real keys above and direct internet, so leave all three UNSET (or 0).
#
# GEMINI_USE_REST=0        # 1 = call Gemini via raw REST (proxy mode) instead of the SDK
# ELEVEN_USE_REST=0        # 1 = call ElevenLabs via raw REST (proxy mode) instead of the SDK
# PROXY_INSECURE_TLS=0     # 1 = relax TLS verification on the proxy hop (sandbox only)
